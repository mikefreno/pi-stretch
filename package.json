{
  "name": "@mikefreno/pi-stretch",
  "version": "0.1.0",
  "description": "Stretchtext for pi — replies arrive short; click a phrase and it grows in place. A port of cc-stretch.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "stretchtext",
    "cc-stretch",
    "tui"
  ],
  "author": "Michael Freno",
  "license": "MIT",
  "homepage": "https://github.com/mikefreno/pi-stretch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikefreno/pi-stretch.git"
  },
  "bugs": {
    "url": "https://github.com/mikefreno/pi-stretch/issues"
  },
  "files": [
    "index.ts",
    "grow.ts",
    "guide.ts",
    "inline.ts",
    "parse.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "JITI_ALIAS='{\"@earendil-works/pi-tui\":\"/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-tui/dist/index.js\"}' node /opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent/node_modules/jiti/lib/jiti-cli.mjs index.test.ts",
    "typecheck": "tsc -p ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
